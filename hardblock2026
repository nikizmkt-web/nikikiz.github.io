<!DOCTYPE html>
<html lang="ko">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>부산 간담회 2026 · Mission Control</title>
<style>
  :root {
    --bg: #0b1220;
    --card: rgba(255,255,255,0.06);
    --stroke: rgba(255,255,255,0.12);
    --text: #e8eefc;
    --muted: #9db0d0;
    --accent: #00d4aa;
    --accent2: #5b8cff;
    --warn: #ffb020;
    --danger: #ff5d7a;
    --ok: #3ddc97;
    --shadow: 0 20px 60px rgba(0,0,0,.45);
    --radius: 18px;
    --font: "Pretendard", "Apple SD Gothic Neo", "Noto Sans KR", system-ui, sans-serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--font);
    color: var(--text);
    background:
      radial-gradient(1200px 600px at 10% -10%, rgba(0,212,170,.18), transparent 50%),
      radial-gradient(900px 500px at 90% 0%, rgba(91,140,255,.2), transparent 45%),
      radial-gradient(800px 400px at 50% 100%, rgba(255,93,122,.12), transparent 40%),
      var(--bg);
    min-height: 100vh;
  }
  .wrap { max-width: 1280px; margin: 0 auto; padding: 28px 20px 60px; }
  .hero {
    display: grid;
    grid-template-columns: 1.4fr .8fr;
    gap: 18px;
    margin-bottom: 22px;
  }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } }
  .glass {
    background: linear-gradient(180deg, rgba(255,255,255,.09), rgba(255,255,255,.04));
    border: 1px solid var(--stroke);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    backdrop-filter: blur(14px);
  }
  .hero-main { padding: 28px; position: relative; overflow: hidden; }
  .hero-main::after {
    content: "";
    position: absolute; right: -40px; top: -40px; width: 180px; height: 180px;
    background: radial-gradient(circle, rgba(0,212,170,.35), transparent 70%);
    filter: blur(10px);
  }
  .badge {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 6px 12px; border-radius: 999px;
    background: rgba(0,212,170,.12); color: var(--accent);
    border: 1px solid rgba(0,212,170,.35); font-size: 12px; font-weight: 700;
  }
  h1 { margin: 14px 0 8px; font-size: clamp(24px, 4vw, 36px); line-height: 1.2; }
  .sub { color: var(--muted); font-size: 15px; line-height: 1.6; }
  .meta { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 18px; }
  .chip {
    padding: 8px 12px; border-radius: 12px; background: rgba(255,255,255,.06);
    border: 1px solid var(--stroke); font-size: 13px;
  }
  .chip b { color: var(--accent); }
  .countdown {
    padding: 28px; display: flex; flex-direction: column; justify-content: center; gap: 10px;
    background: linear-gradient(145deg, rgba(91,140,255,.18), rgba(0,212,170,.08)), rgba(255,255,255,.04);
  }
  .d-label { color: var(--muted); font-size: 13px; font-weight: 600; }
  .d-num {
    font-size: clamp(42px, 8vw, 64px); font-weight: 800; letter-spacing: -1px;
    background: linear-gradient(90deg, #fff, #9be7ff 40%, #00d4aa);
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .d-sub { color: var(--muted); font-size: 14px; }
  .stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px; margin-bottom: 18px; }
  @media (max-width: 800px) { .stats { grid-template-columns: repeat(2, 1fr); } }
  .stat { padding: 16px 18px; }
  .stat .k { color: var(--muted); font-size: 12px; margin-bottom: 6px; }
  .stat .v { font-size: 28px; font-weight: 800; }
  .stat .bar {
    height: 6px; border-radius: 99px; background: rgba(255,255,255,.08); margin-top: 10px; overflow: hidden;
  }
  .stat .bar > i {
    display: block; height: 100%; border-radius: 99px;
    background: linear-gradient(90deg, var(--accent2), var(--accent));
  }
  .toolbar {
    display: flex; flex-wrap: wrap; gap: 10px; align-items: center; margin: 8px 0 16px;
  }
  input, select, button {
    font: inherit; color: var(--text);
    background: rgba(255,255,255,.06); border: 1px solid var(--stroke);
    border-radius: 12px; padding: 10px 12px; outline: none;
  }
  input { min-width: 220px; flex: 1; }
  button {
    cursor: pointer;
    background: linear-gradient(135deg, rgba(0,212,170,.25), rgba(91,140,255,.25));
    border-color: rgba(0,212,170,.35); font-weight: 700;
  }
  button:hover { filter: brightness(1.1); }
  .legend { display: flex; gap: 10px; flex-wrap: wrap; margin-left: auto; font-size: 13px; color: var(--muted); }
  .dot { width: 10px; height: 10px; border-radius: 50%; display: inline-block; margin-right: 6px; }
  .timeline { display: flex; flex-direction: column; gap: 14px; }
  .phase-title {
    margin: 18px 0 6px; font-size: 13px; letter-spacing: .08em; text-transform: uppercase;
    color: var(--muted); display: flex; align-items: center; gap: 8px;
  }
  .phase-title::after { content: ""; flex: 1; height: 1px; background: var(--stroke); }
  .card {
    display: grid; grid-template-columns: 88px 1fr auto; gap: 14px; padding: 16px 18px;
    align-items: start; transition: .2s ease;
  }
  @media (max-width: 720px) {
    .card { grid-template-columns: 72px 1fr; }
    .card .right { grid-column: 1 / -1; }
  }
  .card:hover { transform: translateY(-2px); border-color: rgba(0,212,170,.35); }
  .card.overdue { box-shadow: 0 0 0 1px rgba(255,93,122,.35), var(--shadow); }
  .card.today { box-shadow: 0 0 0 1px rgba(255,176,32,.45), var(--shadow); }
  .dday-box {
    width: 88px; min-height: 72px; border-radius: 14px; display: grid; place-items: center;
    background: rgba(255,255,255,.05); border: 1px solid var(--stroke); text-align: center; padding: 8px;
  }
  .dday-box .n { font-size: 22px; font-weight: 800; line-height: 1; }
  .dday-box .t { font-size: 11px; color: var(--muted); margin-top: 4px; }
  .dday-box.danger { background: rgba(255,93,122,.12); border-color: rgba(255,93,122,.35); color: #ffb3c0; }
  .dday-box.warn { background: rgba(255,176,32,.12); border-color: rgba(255,176,32,.35); color: #ffd089; }
  .dday-box.ok { background: rgba(61,220,151,.1); border-color: rgba(61,220,151,.3); color: #9af0c8; }
  .dday-box.done { background: rgba(91,140,255,.12); border-color: rgba(91,140,255,.3); color: #b7c9ff; }
  .title { font-size: 16px; font-weight: 740; margin: 0 0 6px; }
  .desc { color: var(--muted); font-size: 13px; line-height: 1.55; margin: 0 0 10px; }
  .tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .tag {
    font-size: 12px; padding: 4px 8px; border-radius: 8px;
    background: rgba(255,255,255,.06); border: 1px solid var(--stroke); color: #c9d7f2;
  }
  .right {
    display: flex; flex-direction: column; align-items: flex-end; gap: 8px; min-width: 150px;
  }
  .status {
    font-size: 12px; font-weight: 800; padding: 6px 10px; border-radius: 999px; border: 1px solid;
  }
  .status.진행중 { color: #7dffe0; background: rgba(0,212,170,.12); border-color: rgba(0,212,170,.35); }
  .status.대기중 { color: #c2cde3; background: rgba(123,141,176,.12); border-color: rgba(123,141,176,.3); }
  .status.완료 { color: #b7ffd9; background: rgba(61,220,151,.12); border-color: rgba(61,220,151,.35); }
  .status.지연 { color: #ffc1cc; background: rgba(255,93,122,.12); border-color: rgba(255,93,122,.35); }
  .owner { font-size: 12px; color: var(--muted); }
  .confirmed { font-size: 12px; color: var(--accent); font-weight: 700; }
  .status-select {
    width: 100%;
    font-size: 13px !important;
    font-weight: 700 !important;
    padding: 8px 10px !important;
    border-radius: 10px !important;
    cursor: pointer;
    text-align: center;
  }
  .status-select.대기중 {
    background: rgba(123,141,176,.18) !important;
    border-color: rgba(123,141,176,.45) !important;
    color: #d5def0 !important;
  }
  .status-select.진행중 {
    background: rgba(0,212,170,.16) !important;
    border-color: rgba(0,212,170,.45) !important;
    color: #9bffe8 !important;
  }
  .status-select.완료 {
    background: rgba(61,220,151,.16) !important;
    border-color: rgba(61,220,151,.45) !important;
    color: #b7ffd9 !important;
  }
  .note {
    margin-top: 8px; width: 100%; min-height: 34px; resize: vertical;
    background: rgba(0,0,0,.2); border: 1px dashed rgba(255,255,255,.15);
    border-radius: 10px; padding: 8px 10px; color: #d7e3ff; font-size: 12px;
  }
  .footer {
    margin-top: 28px; padding: 16px 18px; color: var(--muted); font-size: 13px; line-height: 1.6;
  }
  .toast {
    position: fixed; right: 18px; bottom: 18px; z-index: 50; display: none;
    background: #121a2b; border: 1px solid rgba(255,176,32,.4); color: #fff;
    padding: 14px 16px; border-radius: 14px; box-shadow: var(--shadow); max-width: 320px;
  }
  .toast.show { display: block; animation: pop .25s ease; }
  @keyframes pop { from { transform: translateY(8px); opacity: 0; } to { transform: none; opacity: 1; } }
  .hint {
    font-size: 11px; color: var(--muted); opacity: .85; text-align: right; line-height: 1.4;
  }
</style>
</head>
<body>
  <div class="wrap">
    <div class="hero">
      <section class="glass hero-main">
        <div class="badge">🚀 BUSAN HOTEL ROUNDTABLE · 2026</div>
        <h1>부산 간담회 Mission Control</h1>
        <p class="sub">
          유관 부서가 한 화면에서 진행현황을 보고, D-day 기준으로 우선순위를 맞추는 운영 타워입니다.<br/>
          상태값은 <b style="color:var(--accent)">대기중 / 진행중 / 완료</b> 중 선택 · 기한 초과 시 자동 <b style="color:var(--danger)">지연</b> 표시
        </p>
        <div class="meta">
          <div class="chip">📅 <b>2026.10.28 (수) 오후</b></div>
          <div class="chip">👥 참석 <b>약 50인</b></div>
          <div class="chip">📍 <b>그랜드 조선 부산</b></div>
          <div class="chip">🧭 Owner: <b>김지은 · 임정혁 · 네이버</b></div>
        </div>
      </section>
      <section class="glass countdown">
        <div class="d-label">EVENT D-DAY</div>
        <div class="d-num" id="eventDday">-</div>
        <div class="d-sub" id="eventDateText">2026년 10월 28일 (수) 오후</div>
        <div class="d-sub" id="nowText"></div>
      </section>
    </div>

    <div class="stats">
      <div class="glass stat"><div class="k">전체 과제</div><div class="v" id="sTotal">0</div></div>
      <div class="glass stat"><div class="k">진행중</div><div class="v" id="sDoing" style="color:var(--accent)">0</div></div>
      <div class="glass stat"><div class="k">대기중 · 지연</div><div class="v" id="sWait">0</div></div>
      <div class="glass stat">
        <div class="k">완료율</div>
        <div class="v" id="sRate">0%</div>
        <div class="bar"><i id="sBar" style="width:0%"></i></div>
      </div>
    </div>

    <div class="toolbar">
      <input id="q" placeholder="검색: 업무 / 담당자 / 키워드" />
      <select id="phase"><option value="all">전체 단계</option></select>
      <select id="status">
        <option value="all">전체 상태</option>
        <option value="대기중">대기중</option>
        <option value="진행중">진행중</option>
        <option value="완료">완료</option>
        <option value="지연">지연(자동)</option>
      </select>
      <select id="owner"><option value="all">전체 담당자</option></select>
      <button onclick="requestNotify()">🔔 브라우저 알림 켜기</button>
      <button onclick="exportCSV()">⬇️ CSV 내보내기</button>
      <button onclick="window.print()">🖨️ 인쇄/PDF</button>
      <div class="legend">
        <span><i class="dot" style="background:var(--danger)"></i>지연/임박</span>
        <span><i class="dot" style="background:var(--warn)"></i>D-3 이내</span>
        <span><i class="dot" style="background:var(--ok)"></i>여유</span>
      </div>
    </div>

    <div class="timeline" id="timeline"></div>

    <section class="glass footer">
      <b>상태 선택 가이드</b> · 카드 오른쪽 드롭다운에서 <b>대기중 / 진행중 / 완료</b>만 선택하세요.
      마감일이 지났는데 완료가 아니면 상단 배지가 자동으로 <b>지연</b>으로 바뀝니다. 메모·상태는 이 브라우저에 자동 저장됩니다.<br/>
      오늘 우선순위: 기한 지난 항목 완료 처리 → 아젠다 엣지 확정 → 설문 문항 락. 부산 판, 우리가 리드합니다 🔥
    </section>
  </div>

  <div class="toast" id="toast"></div>

<script>
const EVENT_DATE = new Date('2026-10-28T14:00:00+09:00');
const STATUS_OPTIONS = ['대기중', '진행중', '완료']; // 선택 가능 상태 (요청 반영)

const TASKS = [
  {id:1, phase:'기획 & 셋업', title:'일정 및 행사 베뉴 선정', owner:'김지은, 임정혁',
   detail:'간담회 개최 일자 확정, 부산 현지 연회장 후보군 리서치 및 대여·다과 견적 비교',
   confirmed:'그랜드 조선 부산', status:'진행중', due:'2026-09-16'},
  {id:2, phase:'기획 & 셋업', title:'프로젝트 타임라인 확정', owner:'김지은, 임정혁',
   detail:'D-Day 역산 상세 일정 수립 및 네이버 주간보고 아젠다 공식 등록',
   confirmed:'', status:'진행중', due:'2026-09-16'},
  {id:3, phase:'기획 & 셋업', title:'아젠다 선정 및 엣지 발굴', owner:'김지은, 임정혁',
   detail:'부산 맞춤형 핵심 차별화 포인트 아이데이션 (사입 확대, 여행핫딜/쇼핑라이브, 멤버십몰, F&B N예약·Npay 등)',
   confirmed:'', status:'진행중', due:'2026-09-21'},
  {id:4, phase:'사전 조사', title:'설문지 문항 기획', owner:'김지은',
   detail:'지난 제주 설문 레퍼런스를 바탕으로 호텔 니즈 파악 및 조건 제시 문항 초안 작성',
   confirmed:'', status:'진행중', due:'2026-09-22'},
  {id:5, phase:'사전 조사', title:'설문 검토 및 배포', owner:'김지은',
   detail:'네이버 측 피드백 반영 후 부산 대상 호텔에 설문 배포 및 마감일 설정',
   confirmed:'', status:'대기중', due:'2026-09-29'},
  {id:6, phase:'사전 조사', title:'설문 결과 취합 및 분석', owner:'김지은',
   detail:'회신 데이터 취합, 아젠다별 관심도/참여 의향 분석 및 발표 자료 기초 데이터화',
   confirmed:'', status:'대기중', due:'2026-09-30'},
  {id:7, phase:'호텔 섭외', title:'초청 대상 호텔 리스트 확정', owner:'김지은',
   detail:'설문 참여도 및 주요 성급/지역별 타깃 호텔 1차 리스트 수립',
   confirmed:'', status:'대기중', due:'2026-10-01'},
  {id:8, phase:'호텔 섭외', title:'핵심 호텔 개별 사전 컨택', owner:'김지은',
   detail:'핵심 주요 호텔 개별 유선/대면 컨택을 통한 참석 독려 및 세부 안건 참여 의향 타진',
   confirmed:'', status:'대기중', due:'2026-10-07'},
  {id:9, phase:'호텔 섭외', title:'최종 참석자 RSVP 마감', owner:'김지은',
   detail:'초청장 발송, 최종 참석자 및 호텔 확정, 연회장 보증인원 반영',
   confirmed:'', status:'대기중', due:'2026-10-08'},
  {id:10, phase:'콘텐츠 제작', title:'발표 자료(PPT) 초안 작성', owner:'임정혁',
   detail:'설문 결과 및 핵심 아젠다 중심 슬라이드 구성 및 작성',
   confirmed:'', status:'대기중', due:'2026-10-16'},
  {id:11, phase:'콘텐츠 제작', title:'자료 리뷰 및 수정·보완', owner:'임정혁, 네이버',
   detail:'네이버-TTP 사전 합동 리뷰 미팅 진행 및 피드백 반영 최종본 확정',
   confirmed:'', status:'대기중', due:'2026-10-20'},
  {id:12, phase:'운영 준비', title:'식순 확정 및 제작물 발주', owner:'김지은',
   detail:'분 단위 행사 식순 확정, 현수막·네임택·안내 슬라이드 및 출력물 제작',
   confirmed:'', status:'대기중', due:'2026-10-21'},
  {id:13, phase:'운영 준비', title:'다과 및 네트워킹 석식 예약', owner:'김지은',
   detail:'연회장 커피브레이크 세팅 및 간담회 종료 후 석식 장소 섭외',
   confirmed:'', status:'대기중', due:'2026-10-23'},
  {id:14, phase:'행사 진행', title:'최종 리허설 및 현장 운영', owner:'전원',
   detail:'현장 세팅, 발표 리허설 진행, 참석자 등록 및 간담회 운영',
   confirmed:'', status:'대기중', due:'2026-10-26'},
  {id:15, phase:'사후 관리', title:'현장 피드백 정리 및 후속 액션', owner:'김지은',
   detail:'호텔별 질의사항 정리, 제휴 조건 확정 및 후속 계약/프로모션 트래킹',
   confirmed:'', status:'대기중', due:'2026-10-30'},
];

const notesKey = 'busan_roundtable_notes_v2';
const statusKey = 'busan_roundtable_status_v2';
let noteMap = JSON.parse(localStorage.getItem(notesKey) || '{}');
let statusMap = JSON.parse(localStorage.getItem(statusKey) || '{}');

// 이전 버전 '대기' → '대기중' 마이그레이션
Object.keys(statusMap).forEach(k => {
  if (statusMap[k] === '대기' || statusMap[k] === '지연') {
    if (statusMap[k] === '대기') statusMap[k] = '대기중';
    if (statusMap[k] === '지연') statusMap[k] = '진행중'; // 지연은 자동 배지, 선택값은 진행중 유지
  }
});
localStorage.setItem(statusKey, JSON.stringify(statusMap));

function daysBetween(a, b) {
  const MS = 24*60*60*1000;
  const aa = new Date(a.getFullYear(), a.getMonth(), a.getDate());
  const bb = new Date(b.getFullYear(), b.getMonth(), b.getDate());
  return Math.round((bb - aa) / MS);
}

function normalizeStatus(s) {
  if (s === '대기') return '대기중';
  if (s === '지연') return '진행중';
  if (STATUS_OPTIONS.includes(s)) return s;
  return '대기중';
}

function getStatus(task) {
  return normalizeStatus(statusMap[task.id] || task.status);
}

// 화면 표시용: 완료 아닌데 기한 지났으면 '지연'
function displayStatus(task, dday) {
  const st = getStatus(task);
  if (st === '완료') return '완료';
  if (dday < 0) return '지연';
  return st;
}

function ddayMeta(dday, status) {
  if (status === '완료') return {cls:'done', label:'DONE', text:'완료'};
  if (dday < 0) return {cls:'danger', label:`D+${Math.abs(dday)}`, text:'지연'};
  if (dday === 0) return {cls:'danger', label:'D-DAY', text:'오늘 마감'};
  if (dday <= 3) return {cls:'warn', label:`D-${dday}`, text:'임박'};
  return {cls:'ok', label:`D-${dday}`, text:'진행'};
}

function render() {
  const now = new Date();
  const eventDiff = daysBetween(now, EVENT_DATE);
  document.getElementById('eventDday').textContent = eventDiff >= 0 ? `D-${eventDiff}` : `D+${Math.abs(eventDiff)}`;
  document.getElementById('nowText').textContent = `기준 시각: ${now.toLocaleString('ko-KR')}`;

  const q = document.getElementById('q').value.trim().toLowerCase();
  const phase = document.getElementById('phase').value;
  const statusF = document.getElementById('status').value;
  const ownerF = document.getElementById('owner').value;

  const byPhase = {};

  // 통계
  let doing = 0, waitLike = 0, doneCnt = 0;
  TASKS.forEach(t => {
    const due = new Date(t.due + 'T23:59:59+09:00');
    const dday = daysBetween(now, due);
    const st = displayStatus(t, dday);
    const raw = getStatus(t);
    if (raw === '완료') doneCnt++;
    if (st === '진행중') doing++;
    if (st === '대기중' || st === '지연') waitLike++;
  });

  document.getElementById('sTotal').textContent = TASKS.length;
  document.getElementById('sDoing').textContent = doing;
  document.getElementById('sWait').textContent = waitLike;
  const rate = Math.round((doneCnt / TASKS.length) * 100);
  document.getElementById('sRate').textContent = rate + '%';
  document.getElementById('sBar').style.width = rate + '%';

  TASKS.forEach(t => {
    const due = new Date(t.due + 'T23:59:59+09:00');
    const dday = daysBetween(now, due);
    const st = displayStatus(t, dday);
    const raw = getStatus(t);

    const hay = `${t.phase} ${t.title} ${t.owner} ${t.detail} ${t.confirmed}`.toLowerCase();
    if (q && !hay.includes(q)) return;
    if (phase !== 'all' && t.phase !== phase) return;
    if (statusF !== 'all' && st !== statusF) return;
    if (ownerF !== 'all' && !t.owner.includes(ownerF)) return;

    if (!byPhase[t.phase]) byPhase[t.phase] = [];
    byPhase[t.phase].push({t, dday, st, raw});
  });

  const root = document.getElementById('timeline');
  root.innerHTML = '';

  const phaseOrder = ['기획 & 셋업','사전 조사','호텔 섭외','콘텐츠 제작','운영 준비','행사 진행','사후 관리'];
  phaseOrder.forEach(p => {
    const rows = byPhase[p];
    if (!rows || !rows.length) return;

    const h = document.createElement('div');
    h.className = 'phase-title';
    h.textContent = p;
    root.appendChild(h);

    rows.forEach(({t, dday, st, raw}) => {
      const meta = ddayMeta(dday, st);
      const el = document.createElement('article');
      el.className = `glass card ${dday < 0 && st!=='완료' ? 'overdue' : ''} ${dday===0 && st!=='완료' ? 'today' : ''}`;
      el.innerHTML = `
        <div class="dday-box ${meta.cls}">
          <div class="n">${meta.label}</div>
          <div class="t">${t.due.replaceAll('-','.')}</div>
        </div>
        <div>
          <h3 class="title">${t.title}</h3>
          <p class="desc">${t.detail}</p>
          <div class="tags">
            <span class="tag">단계 · ${t.phase}</span>
            <span class="tag">담당 · ${t.owner}</span>
            ${t.confirmed ? `<span class="tag">확정 · ${t.confirmed}</span>` : ''}
          </div>
          <textarea class="note" placeholder="팔로업 메모 (자동 저장)" data-id="${t.id}">${noteMap[t.id]||''}</textarea>
        </div>
        <div class="right">
          <div class="status ${st}">${st}</div>
          <div class="owner">${t.owner}</div>
          ${t.confirmed ? `<div class="confirmed">✅ ${t.confirmed}</div>` : ''}
          <select class="status-select ${raw}" data-status-id="${t.id}" title="진행 현황 선택">
            ${STATUS_OPTIONS.map(s => `<option value="${s}" ${s===raw?'selected':''}>${s}</option>`).join('')}
          </select>
          <div class="hint">${st==='지연' ? '⚠ 기한 경과 · 완료 처리 또는 일정 재조정' : '진행 현황 선택'}</div>
        </div>`;
      root.appendChild(el);
    });
  });

  root.querySelectorAll('textarea.note').forEach(tr => {
    tr.addEventListener('input', e => {
      noteMap[e.target.dataset.id] = e.target.value;
      localStorage.setItem(notesKey, JSON.stringify(noteMap));
    });
  });

  root.querySelectorAll('select[data-status-id]').forEach(sel => {
    sel.addEventListener('change', e => {
      const id = e.target.dataset.statusId;
      const val = e.target.value;
      statusMap[id] = val;
      localStorage.setItem(statusKey, JSON.stringify(statusMap));
      render();
      toast(`상태 변경 → ${val}  ✓  팀 공유 전 Sheets에도 반영하세요`);
    });
  });

  checkAlerts(now);
}

function fillFilters() {
  const phases = [...new Set(TASKS.map(t => t.phase))];
  const owners = [...new Set(TASKS.flatMap(t => t.owner.split(',').map(s => s.trim())))];
  const psel = document.getElementById('phase');
  const osel = document.getElementById('owner');
  phases.forEach(p => psel.insertAdjacentHTML('beforeend', `<option>${p}</option>`));
  owners.forEach(o => osel.insertAdjacentHTML('beforeend', `<option>${o}</option>`));
}

function toast(msg) {
  const el = document.getElementById('toast');
  el.textContent = msg;
  el.classList.add('show');
  setTimeout(() => el.classList.remove('show'), 2800);
}

function checkAlerts(now) {
  const urgent = TASKS.filter(t => {
    if (getStatus(t) === '완료') return false;
    const dday = daysBetween(now, new Date(t.due + 'T23:59:59+09:00'));
    return dday <= 1;
  });
  if (!urgent.length) return;
  const msg = `임박/지연 ${urgent.length}건: ` + urgent.slice(0,3).map(t => t.title).join(', ');
  toast('⚡ ' + msg);
  if (Notification.permission === 'granted') {
    const key = 'busan_alert_' + now.toDateString();
    if (sessionStorage.getItem(key)) return;
    new Notification('부산 간담회 타임라인', { body: msg, lang: 'ko' });
    sessionStorage.setItem(key, '1');
  }
}

function requestNotify() {
  if (!('Notification' in window)) return toast('이 브라우저는 알림을 지원하지 않아요');
  Notification.requestPermission().then(p => {
    toast(p === 'granted' ? '알림 활성화! 임박 과제 있으면 알려드릴게요' : '알림 권한이 필요해요');
  });
}

function exportCSV() {
  const now = new Date();
  const rows = [['단계','세부 업무','담당자','세부 내용','확정 사항','진행 상태(선택)','표시 상태','마감일','D-day','메모']];
  TASKS.forEach(t => {
    const dday = daysBetween(now, new Date(t.due+'T23:59:59+09:00'));
    const raw = getStatus(t);
    const st = displayStatus(t, dday);
    rows.push([t.phase,t.title,t.owner,t.detail,t.confirmed,raw,st,t.due, dday, (noteMap[t.id]||'').replaceAll('\n',' ')]);
  });
  const csv = rows.map(r => r.map(x => `"${String(x).replaceAll('"','""')}"`).join(',')).join('\n');
  const blob = new Blob(['\ufeff' + csv], {type:'text/csv;charset=utf-8;'});
  const a = document.createElement('a');
  a.href = URL.createObjectURL(blob);
  a.download = '부산_간담회_타임라인.csv';
  a.click();
}

['q','phase','status','owner'].forEach(id => {
  document.getElementById(id).addEventListener('input', render);
  document.getElementById(id).addEventListener('change', render);
});

fillFilters();
render();
setInterval(render, 60_000);
</script>
</body>
